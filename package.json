{
  "name": "codes.lucasvdh.omnik",
  "version": "1.6.0",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test --enable-source-maps \".test-build/tests/**/*.test.js\"",
    "test:coverage": "npm test -- --experimental-test-coverage",
    "check-locales": "node scripts/check-locales.mjs",
    "homey-manifest": "node -e \"require('fs').existsSync('app.json') || require('fs').copyFileSync('.homeycompose/app.json', 'app.json')\"",
    "homey-build": "npm run homey-manifest && homey app build",
    "homey-validate": "npm run homey-manifest && homey app validate --level verified",
    "homey-review": "npm run homey-manifest && homey app review",
    "homey-run": "npm run homey-manifest && homey app run"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^26.6.6",
    "eslint": "^9.0.0",
    "homey": "^4.6.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
